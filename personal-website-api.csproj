<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAzureFunctionsWorker>true</UseAzureFunctionsWorker> <!-- ✅ required -->
  </PropertyGroup>

  <ItemGroup>
  <!-- Functions Worker SDK (emits function.json) -->
  <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.ServiceBus" Version="5.22.2" />
  <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.2" OutputItemType="Analyzer" />

  <!-- Core isolated-worker runtime -->
  <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.0.0" />

  <!-- HTTP trigger binding for isolated worker -->
  <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
  <PackageReference Include="Microsoft.Azure.WebJobs" Version="3.0.41" />
  <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="7.0.3" />

  <!-- Your other deps (EF Core, etc.) -->
  <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
  <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="9.0.5">
    <PrivateAssets>all</PrivateAssets>
  </PackageReference>
  <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.0.3" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="personal-website-api.Tests/**" />
  </ItemGroup>

</Project>